# Inoversity Frontend — environment template
# Copiază în .env.local și completează valorile

# ── API endpoint ─────────────────────────────────────────────
# URL-ul către backend-ul Inoversity (rulează separat din inoversity-backend)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── App URL (folosit pentru link-uri absolute, OG tags, etc.) ─
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe ───────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
